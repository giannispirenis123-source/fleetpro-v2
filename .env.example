# ─────────────────────────────────────────
# FleetPro v2 — Environment Variables
# Αντέγραψε αυτό το αρχείο ως .env.local
# ─────────────────────────────────────────

# Database (Supabase)
# DATABASE_URL = pooled connection (Transaction mode, port 6543) — για serverless/Vercel
# DIRECT_URL   = direct connection (port 5432) — μόνο για prisma migrate / db push
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT Secret (τουλάχιστον 32 χαρακτήρες)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FleetPro"

# Super Admin (δημιουργείται με seed)
SUPER_ADMIN_EMAIL="superadmin@fleetpro.gr"
SUPER_ADMIN_PASSWORD="FleetPro2025!"

# Cloudinary (φωτογραφίες οχημάτων) — ΜΟΝΟ server. Το secret ποτέ με NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Supabase Storage (φωτογραφίες ζημιών) — ΜΟΝΟ server-side, ποτέ NEXT_PUBLIC_
# Bucket: fleetpro-files (ιδιωτικό). Βλ. docs/HANDOFF.md §3.1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — online πληρωμές κρατήσεων (Connect) + συνδρομές εταιριών (Billing).
# Το STRIPE_SECRET_KEY είναι του λογαριασμού της πλατφόρμας (ΚΟΙΝΟ για τα δύο).
# Το Billing δουλεύει ΜΟΝΟ με sk_test_ (με sk_live_ είναι κλειστό).
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret του webhook «Connected accounts» → /api/stripe/connect/webhook
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# Συνδρομές (Stripe Billing, SQL 36) — ΞΕΧΩΡΙΣΤΟ webhook «Your account» →
# /api/billing/webhook. Χωρίς ΟΛΑ τα παρακάτω το Billing είναι κλειστό και οι
# νέες εγγραφές μένουν εκτός χρέωσης (όπως πριν). Βλ. docs/HANDOFF.md.
STRIPE_BILLING_WEBHOOK_SECRET="whsec_..."
STRIPE_BILLING_PRICE_STARTER_MONTHLY="price_..."
STRIPE_BILLING_PRICE_STARTER_YEARLY="price_..."
STRIPE_BILLING_PRICE_PRO_MONTHLY="price_..."
STRIPE_BILLING_PRICE_PRO_YEARLY="price_..."
STRIPE_BILLING_PRICE_BUSINESS_MONTHLY="price_..."
STRIPE_BILLING_PRICE_BUSINESS_YEARLY="price_..."
# ΜΟΝΟ δοκιμές: test clock ανά νέο πελάτη. Ισχύει μόνο με sk_test_ ΚΑΙ VERCEL_ENV=preview.
STRIPE_BILLING_TEST_CLOCKS=

# Email (Resend) — «Αποστολή στον πελάτη» (συμβόλαιο + PDF). Το πακέτο
# resend θέλει Node 20+. Χωρίς RESEND_API_KEY η αποστολή δίνει καθαρό
# σφάλμα. EMAIL_FROM: onboarding@resend.dev μέχρι να επαληθευτεί δικό σας
# domain στο Resend (με αυτό στέλνει μόνο στο email του λογαριασμού Resend).
RESEND_API_KEY="re_..."
EMAIL_FROM="onboarding@resend.dev"

// FleetPro v2 — Multi-Tenant Prisma Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Serverless (Vercel): pooled connection μέσω Supabase pgBouncer (port 6543)
  url       = env("DATABASE_URL")
  // Απευθείας σύνδεση (port 5432) — χρειάζεται μόνο για migrations / db push
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  STAFF
  PARTNER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum VehicleCategory {
  A
  B
  C
  SUV
  PREMIUM
  LUXURY
  VAN
  MOTORCYCLE
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InsuranceType {
  BASIC
  STANDARD
  FULL
}

// Πότε εκδίδεται αυτόματα το τιμολόγιο.
enum ContractStatus {
  DRAFT
  SIGNED
  COMPLETED
}

enum InvoiceIssueTrigger {
  ON_COMPLETION // με το τέλος της ενοικίασης
  ON_CONTRACT // με την ολοκλήρωση συμβολαίου — δεν ενεργεί ακόμα
}

// Αυτόματη ή χειροκίνητη αποστολή του τιμολογίου στον πελάτη.
enum InvoiceSendMode {
  AUTO
  MANUAL
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum DamageStatus {
  PENDING
  RESOLVED
}

enum ServiceType {
  REGULAR
  KTEO
  TYRES
  BRAKES
  BATTERY
  REPAIR
  OTHER
}

enum ChargeType {
  PER_DAY
  ONE_OFF
}

enum ExtraType {
  EXTRA
  INSURANCE
}

// Τρόπος λειτουργίας της εταιρίας: άμεση κράτηση ή αίτημα προς έγκριση.
enum RentalMode {
  BOOKING
  REQUEST
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Έκπτωση ΣΥΝΔΡΟΜΗΣ εταιρίας (Super Admin) — άσχετη με τις εκπτώσεις κρατήσεων.
enum PlatformDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountTarget {
  ALL
  CATEGORY
  VEHICLE
  CUSTOMER
}

enum NotificationType {
  SERVICE_DUE
  INSURANCE_EXPIRY
  CONTRACT_UNSIGNED
  BOOKING_NEW
  BOOKING_CANCELLED
  PAYMENT_OVERDUE
  DAMAGE_REPORTED
}

// ─────────────────────────────────────────
// PLATFORM LEVEL
// ─────────────────────────────────────────

model Tenant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique // subdomain: slug.fleetpro.gr
  email           String           @unique
  phone           String?
  address         String?
  vat             String?
  // ΔΟΥ και περιοχή — για την κεφαλίδα του συμβολαίου.
  taxOffice       String?
  region          String?
  iban            String?
  logoUrl         String?
  // Λογότυπο στο Storage (ιδιωτικό bucket): tenantId/branding/logo-<τυχαίο>.<ext>.
  // Εμφανίζεται με signed URL· στα συμβόλαια πάντα το ΤΡΕΧΟΝ (όχι snapshot).
  logoPath        String?
  brandColor      String           @default("#2563EB")
  website         String? // external website embed
  status          TenantStatus     @default(TRIAL)
  plan            SubscriptionPlan @default(STARTER)
  rentalMode      RentalMode       @default(BOOKING)
  // Χρόνος προετοιμασίας οχήματος σε λεπτά: το κενό μετά την επιστροφή
  // (καθάρισμα, έλεγχος, μεταφορά) πριν το όχημα είναι ξανά διαθέσιμο.
  prepTimeMinutes Int              @default(0)
  // Στρογγυλοποίηση του ΤΕΛΙΚΟΥ ποσού κράτησης προς τα πάνω, στο
  // πλησιέστερο ακέραιο ευρώ. Οι επιμέρους γραμμές μένουν ακριβείς.
  roundUpTotal    Boolean          @default(false)

  // Domain του δημόσιου site (SQL 33): host σε πεζά, μοναδικό σε όλη την
  // πλατφόρμα (και στο lower()). Σερβίρει ΜΟΝΟ όταν customDomainStatus = VERIFIED.
  customDomain           String?   @unique
  customDomainStatus     String    @default("PENDING") // PENDING | VERIFIED
  customDomainVerifiedAt DateTime?
  // Αποστολέας email ανά εταιρία (SQL 33) — βλ. src/lib/emailSender.ts.
  // Χωρίς VERIFIED → το κοινό EMAIL_FROM.
  emailFromName          String?
  emailFromAddress       String?
  emailSenderStatus      String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED
  emailSenderVerifiedAt  DateTime?

  // Πακέτο (entitlements): ποιες ενότητες και ποια όρια έχει η εταιρία.
  // ΞΕΧΩΡΙΣΤΟ από το "plan" πιο πάνω, που αφορά μόνο την τιμή συνδρομής.
  // null = χωρίς πακέτο (καμία ενότητα, κανένας νέος χρήστης/όχημα).
  planKey              String?
  // Εξαιρέσεις μίας εταιρίας: {"modules":{…},"limits":{…}} — ανά κλειδί
  // υπερισχύουν του πακέτου (και limit null = απεριόριστο). SQL 20.
  entitlementOverrides Json    @default("{}")

  // Δημόσια σελίδα /s/<storefrontSlug>. ΞΕΧΩΡΙΣΤΟ slug από το "slug" πιο
  // πάνω (δεμένο με login/JWT). Ρυθμίσεις στο storefrontSettings (κείμενα
  // ανά γλώσσα, γλώσσες, πληρωμή) — βλ. src/lib/storefront/settings.ts.
  storefrontSlug     String? @unique
  storefrontEnabled  Boolean @default(false)
  storefrontSettings Json    @default("{}")

  // Τιμολόγηση. Οι τιμές των κρατήσεων ΠΕΡΙΕΧΟΥΝ ΦΠΑ· το τιμολόγιο τις
  // σπάει ανάποδα σε καθαρή αξία και ΦΠΑ με αυτό το ποσοστό.
  vatRate             Decimal             @default(24) @db.Decimal(5, 2)
  invoiceIssueTrigger InvoiceIssueTrigger @default(ON_COMPLETION)
  invoiceSendMode     InvoiceSendMode     @default(MANUAL)

  // Όροι ενοικίασης που τυπώνονται στο συμβόλαιο, και στις δύο γλώσσες.
  contractTermsEl String? @db.Text
  contractTermsEn String? @db.Text

  trialEndsAt      DateTime?
  stripeCustomerId String?
  stripeSubId      String?

  // Online πληρωμές κρατήσεων — Stripe Connect Express (SQL 27). ΧΩΡΙΣΤΑ από
  // τα stripeCustomerId/stripeSubId πιο πάνω (συνδρομή της εταιρίας στην πλατφόρμα).
  stripeAccountId        String?  @unique
  stripeChargesEnabled   Boolean  @default(false)
  stripePayoutsEnabled   Boolean  @default(false)
  stripeDetailsSubmitted Boolean  @default(false)
  // PICKUP_ONLY | ONLINE_OR_PICKUP | ONLINE_ONLY — online μόνο με «Ενεργό» λογαριασμό.
  paymentOptions         String   @default("PICKUP_ONLY")
  // FULL | DEPOSIT (depositPercent %, στρογγυλό σε ακέραιο €)
  onlineAmountType       String   @default("FULL")
  depositPercent         Int      @default(30)
  // Προμήθεια πλατφόρμας σε basis points — ΜΟΝΟ ο Super Admin τη βλέπει/αλλάζει.
  platformFeeBps         Int      @default(0)

  // Αυτόματη εγγραφή (SQL 34): 'manual' (Super Admin) | 'self_signup' (/signup).
  signupSource     String    @default("manual")
  // Πρόοδος του onboarding — βλ. src/lib/signup/onboarding.ts. null = καμία λίστα.
  onboardingState  Json?
  // Σήμανση από τον Super Admin για καθάρισμα (ανεπιβεβαίωτη εγγραφή > 7 ημέρες).
  cleanupFlaggedAt DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  users             User[]
  vehicles          Vehicle[]
  customers         Customer[]
  bookings          Booking[]
  invoices          Invoice[]
  serviceRecords    ServiceRecord[]
  expenses          Expense[]
  damages           Damage[]
  contracts         Contract[]
  discounts         Discount[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  contractTemplates ContractTemplate[]
  extras            Extra[]
  platformDiscounts PlatformDiscount[]
  rentalGroups      RentalGroup[]
  pickupLocations   PickupLocation[]
  seasons           Season[]
  rates             Rate[]
  driverAgeBands    DriverAgeBand[]
  promotions        Promotion[]
  bookingMessages   BookingNotification[]
  bookingPayments   BookingPayment[]
  places            Place[]
  reviews           Review[]
  legalTexts        SiteLegalText[]
  entitlementPlan   Plan?                 @relation(fields: [planKey], references: [key], onDelete: SetNull)

  @@index([planKey])
  @@index([signupSource, createdAt])
  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String? // null = Super Admin
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole  @default(STAFF)
  locale       String    @default("el") // "el" | "en" — προτίμηση γλώσσας ανά χρήστη
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Επαλήθευση email (SQL 34). Προεπιλογή now(): όσοι φτιάχνονται από Super
  // Admin / «Χρήστες» είναι επαληθευμένοι. ΜΟΝΟ η εγγραφή (/signup) γράφει null
  // — και τότε ούτε login ούτε dashboard μέχρι τον σύνδεσμο του email.
  emailVerifiedAt DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Granular permissions (JSON για flexibility)
  permissions Json @default("{}")

  // Προμήθεια: ποσοστό σε % και ΑΝΕΞΑΡΤΗΤΟΙ διακόπτες για το πάνω σε τι
  // υπολογίζεται. Αφορά συνεργάτες και προσωπικό· με ποσοστό 0 δεν
  // εμφανίζεται πουθενά.
  commissionRate        Decimal @default(0) @db.Decimal(5, 2)
  commissionOnRental    Boolean @default(true)
  commissionOnExtras    Boolean @default(false)
  commissionOnInsurance Boolean @default(false)

  // Relations
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activityLogs    ActivityLog[]
  sessions        Session[]
  // Οι κρατήσεις που έφερε ως συνεργάτης.
  partnerBookings Booking[]     @relation("PartnerBookings")
  // Οι κρατήσεις που καταχώρησε ο ίδιος, όποιος ρόλος κι αν είναι.
  createdBookings Booking[]     @relation("CreatedBookings")
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

// Σύνδεσμος επαλήθευσης email (SQL 34): ΜΟΝΟ το hash του token, 24 ώρες, μίας χρήσης.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─────────────────────────────────────────
// FLEET
// ─────────────────────────────────────────

model Vehicle {
  id              String          @id @default(cuid())
  tenantId        String
  brand           String
  model           String
  plate           String
  year            Int
  color           String?
  category        VehicleCategory @default(B)
  dailyRate       Decimal         @db.Decimal(10, 2)
  status          VehicleStatus   @default(AVAILABLE)
  km              Int             @default(0)
  fuel            FuelType        @default(PETROL)
  seats           Int             @default(5)
  doors           Int             @default(4)
  transmission    String          @default("Manual")
  ac              Boolean         @default(true)
  nextServiceKm   Int?
  nextServiceDate DateTime?
  insuranceExpiry DateTime?
  kteoExpiry      DateTime?
  images          String[] // ΠΑΛΙΟ, αχρησιμοποίητο — μεταφέρθηκε στο photos (SQL 18)
  /// Φωτογραφίες (Cloudinary): [{ id, url, publicId, order }] — έως 10, η πρώτη είναι η κύρια.
  photos          Json            @default("[]")
  notes           String?
  isActive        Boolean         @default(true)
  // Εμφανίζεται στη δημόσια σελίδα της εταιρίας (SQL 20).
  publicVisible   Boolean         @default(true)
  // Ομάδα ενοικίασης του site (SQL 21) — null = εμφανίζεται μεμονωμένα.
  rentalGroupId   String?
  // 'car' | 'moto' | 'atv' (SQL 21, CHECK στη βάση).
  vehicleType     String          @default("car")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rentalGroup    RentalGroup?    @relation(fields: [rentalGroupId], references: [id], onDelete: SetNull)
  bookings       Booking[]
  serviceRecords ServiceRecord[]
  damages        Damage[]
  expenses       Expense[]
  rates          Rate[]

  @@unique([tenantId, plate])
  @@index([rentalGroupId])
  @@map("vehicles")
}

// ─────────────────────────────────────────
// CUSTOMERS (CRM)
// ─────────────────────────────────────────

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  phone2         String?
  idNumber       String? // ΑΔΤ
  licenseNumber  String?
  licenseExpiry  DateTime?
  licenseCountry String?   @default("GR")
  dateOfBirth    DateTime?
  address        String?
  city           String?
  country        String?   @default("GR")
  nationality    String?
  notes          String?
  tags           String[] // VIP, Corporate, Problematic, etc.
  isBlacklisted  Boolean   @default(false)
  totalRevenue   Decimal   @default(0) @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  invoices  Invoice[]
  contracts Contract[]

  // Σελιδοποίηση: αλφαβητικά ανά εταιρία (SQL 32).
  @@index([tenantId, lastName, firstName, id])
  @@map("customers")
}

// ─────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid())
  tenantId      String
  vehicleId     String
  customerId    String
  bookingNumber String // BP-2025-001
  status        BookingStatus @default(PENDING)

  // Dates — οι ώρες κρατούνται χωριστά ως "HH:mm" (τοπική ώρα εταιρίας).
  // Nullable επειδή οι κρατήσεις πριν την προσθήκη τους δεν έχουν ώρα·
  // σε νέες εγγραφές τις απαιτεί το API.
  pickupDate       DateTime
  pickupTime       String?
  returnDate       DateTime
  returnTime       String?
  actualReturnDate DateTime?

  // Locations
  pickupLocation String?
  returnLocation String?

  // Pricing
  dailyRate      Decimal       @db.Decimal(10, 2)
  totalDays      Int
  subtotal       Decimal       @db.Decimal(10, 2)
  insurance      InsuranceType @default(BASIC)
  insuranceCost  Decimal       @default(0) @db.Decimal(10, 2)
  extrasTotal    Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  discountCode   String?
  total          Decimal       @db.Decimal(10, 2)

  // Deposit
  deposit         Decimal @default(0) @db.Decimal(10, 2)
  depositPaid     Boolean @default(false)
  depositReturned Boolean @default(false)

  // Extras (JSON)
  extras Json @default("{}")

  // Fuel
  fuelLevelPickup Int  @default(100) // percentage
  fuelLevelReturn Int?

  // KM
  kmPickup Int?
  kmReturn Int?

  // Notes
  notes         String?
  internalNotes String?

  // Contract
  contractId     String?   @unique
  contractSigned Boolean   @default(false)
  signedAt       DateTime?

  // Invoice
  invoiceId String?

  // Ο συνεργάτης που έφερε την κράτηση, αν υπάρχει. Οι κρατήσεις που
  // καταχωρεί η ίδια η εταιρία μένουν NULL — καμία προμήθεια.
  partnerId String?

  // Ποιος χρήστης την καταχώρησε. Ξεχωριστό από το partnerId: ο υπάλληλος
  // που γράφει μια κράτηση δεν είναι απαραίτητα ο συνεργάτης που την
  // έφερε. Οι παλιές κρατήσεις μένουν NULL.
  createdById String?

  // Source (web, phone, walk-in, partner)
  source String @default("manual")

  // Ολόκληρη η ανάλυση της quote() τη στιγμή της δημιουργίας/αλλαγής (SQL 22):
  // { version, at, quote: { days, lines, … }, manualDiscount, totalCents, autoPrice }.
  // NULL = παλιά κράτηση (πριν την ενιαία τιμολόγηση) — δεν αγγίζεται.
  priceQuote Json?
  // 'AUTO' (τιμή από τις ρυθμίσεις) | 'MANUAL' (χειροκίνητο ενοίκιο συμβολαίου). NULL = παλιά.
  priceMode  String?

  // Κράτηση από το δημόσιο site (SQL 23): κωδικός που βλέπει ο πελάτης
  // (XXXX-XXXX, μοναδικός σε όλη τη βάση), η ομάδα που διάλεξε και η πτήση.
  // Τα σχόλια του πελάτη μπαίνουν στο notes.
  publicCode    String? @unique
  rentalGroupId String?
  flightNumber  String?

  // Επιβεβαίωση / ακύρωση (SQL 24): γλώσσα του site στην υποβολή (NULL =
  // προεπιλογή εταιρίας), λόγος ακύρωσης από τη λίστα και σημείωμα για τον πελάτη.
  siteLang         String?
  cancelReasonCode String?
  cancelNote       String?

  // Πληρωμή (SQL 27): paymentMethod NULL (dashboard/παλιές) | PICKUP | ONLINE·
  // paymentStatus NONE | AWAITING_PAYMENT | PAID | FAILED | EXPIRED | REFUNDED |
  // PARTIALLY_REFUNDED. Η AWAITING_PAYMENT κρατά το όχημα ΜΕΧΡΙ το paymentExpiresAt.
  paymentMethod    String?
  paymentStatus    String    @default("NONE")
  paymentExpiresAt DateTime?

  // Όροι που αποδέχτηκε ο πελάτης στο site (SQL 31): "terms/el/v3" ή
  // "terms/el/template-2026-10-21". NULL = παλιά κράτηση ή από το dashboard.
  termsVersion    String?
  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id])
  customer    Customer              @relation(fields: [customerId], references: [id])
  partner     User?                 @relation("PartnerBookings", fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation("CreatedBookings", fields: [createdById], references: [id], onDelete: SetNull)
  contract    Contract?
  invoice     Invoice?
  damages     Damage[]
  rentalGroup RentalGroup?          @relation(fields: [rentalGroupId], references: [id], onDelete: SetNull)
  messages    BookingNotification[]
  payments    BookingPayment[]

  @@index([tenantId, partnerId])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, createdById])
  // SQL 30 (audit): μοναδικός αριθμός ανά εταιρία + indexes για συγκρούσεις/λίστες.
  @@unique([tenantId, bookingNumber])
  @@index([tenantId, vehicleId, status])
  @@index([tenantId, status, pickupDate])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("bookings")
}

// ─────────────────────────────────────────
// CONTRACTS
// ─────────────────────────────────────────

model ContractTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  content   String   @db.Text // HTML template with {{placeholders}}
  isDefault Boolean  @default(false)
  language  String   @default("el")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@map("contract_templates")
}

model Contract {
  id         String  @id @default(cuid())
  tenantId   String
  bookingId  String  @unique
  customerId String
  templateId String?

  // Ο κωδικός του συμβολαίου: ΤΥΧΑΙΟΣ (π.χ. C-7F3K9Q), μοναδικός ανά
  // εταιρία — όχι αύξων, ώστε να μη μαρτυρά πλήθος συμβολαίων.
  contractNumber String
  content        String   @default("") @db.Text // αχρησιμοποίητο (παλιό HTML template)
  signatureData  String?  @db.Text // αχρησιμοποίητο: οι υπογραφές ζουν στο drivers
  signature2Data String?  @db.Text // αχρησιμοποίητο
  photosBefore   String[]
  photosAfter    String[]

  status ContractStatus @default(DRAFT)

  // Ποιος υπάλληλος το έφτιαξε — το όνομα κρατιέται ως snapshot.
  createdById   String?
  createdByName String?

  // Snapshot εταιρίας, κράτησης, οχήματος, extras, ασφάλειας (με excess) και
  // όρων ΕΛ/EN. Ανανεώνεται όσο δεν υπάρχει καμία υπογραφή· μετά παγώνει.
  snapshot Json @default("{}")

  // Οδηγοί (ο πρώτος = κύριος), ο καθένας με την υπογραφή του (base64 PNG).
  drivers Json @default("[]")

  pickupLocation    String?
  returnLocation    String?
  // Τύπος καυσίμου που δηλώθηκε στο συμβόλαιο (χωρίς προεπιλογή· null =
  // δεν επιλέχθηκε — το Α4 δείχνει τότε του οχήματος). Κλειδώνει με την υπογραφή.
  fuelType          FuelType?
  // Καύσιμο / μπαταρία σε όγδοα: 0–8.
  fuelPickup        Int?
  // ΠΑΛΙΟ: το καύσιμο παράδοσης δεν καταγράφεται πια. Μένει για τα παλιά
  // συμβόλαια (μόνο ανάγνωση). Δεν σβήνεται.
  fuelReturn        Int?
  // Σημάδια στο σκαρίφημα: [{ id, x, y, note }] με x, y σε % του σχεδίου.
  // ΠΑΛΙΟ: τα νέα συμβόλαια δεν έχουν σκαρίφημα· τα παλιά εμφανίζονται μόνο
  // για ανάγνωση. Δεν σβήνεται.
  damageMarks       Json      @default("[]")
  // Φωτογραφίες ζημιών (Supabase Storage, ιδιωτικό bucket):
  // [{ id, path, group: "PICKUP" | "RETURN", takenAt, note }].
  // Δεν μπαίνουν στο searchText.
  damagePhotos      Json      @default("[]")
  // Ελεύθερη περιγραφή ζημιών ανά ομάδα. Η παραλαβής κλειδώνει με την
  // υπογραφή· η παράδοσης αλλάζει μέχρι την ολοκλήρωση.
  damageNotesPickup String?   @db.Text
  damageNotesReturn String?   @db.Text
  // Αλλαγές οχήματος: [{ id, vehicleId, label, plate, date }].
  vehicleChanges    Json      @default("[]")
  notes             String?   @db.Text

  paymentMethod String? // CASH | CARD | TRANSFER | OTHER
  depositAmount Decimal? @db.Decimal(10, 2)
  depositMethod String? // CASH | CARD | CARD_HOLD
  // Στοιχεία κάρτας για αναγνώριση: { brand, last4, holder, expiry }.
  // Ο πλήρης αριθμός ΜΟΝΟ κρυπτογραφημένος (cardNumberEnc). ΠΟΤΕ CVV.
  paymentCard   Json?
  depositCard   Json?
  // Πλήρης αριθμός κάρτας ΚΡΥΠΤΟΓΡΑΦΗΜΕΝΟΣ (AES-256-GCM, κλειδί
  // CARD_ENCRYPTION_KEY): JSON { payment?, deposit? } — βλ. src/lib/cardCrypto.ts.
  // Αποκρυπτογραφείται μόνο στον server, μόνο για COMPANY_ADMIN. Ποτέ CVV.
  cardNumberEnc String?  @db.Text

  // Κανονικοποιημένο κείμενο αναζήτησης (πεζά, χωρίς τόνους/κενά/σύμβολα),
  // ξαναϋπολογίζεται από τον server σε κάθε αλλαγή. GIN trigram index.
  searchText String? @db.Text

  // Link πελάτη (/c/[token]): τυχαίο token ≥32 bytes, base64url. Φτιάχνεται
  // με την υπογραφή όλων. Λήξη = 90 ημέρες μετά την επιστροφή (υπολογίζεται).
  publicToken          String?   @unique
  publicTokenRevokedAt DateTime?

  // Αποστολή στον πελάτη (email + PDF, Resend): η τελευταία ΕΠΙΤΥΧΗΣ
  // αποστολή και το ιστορικό όλων των προσπαθειών [{ id, at, ok, lang, to
  // (μασκαρισμένο), by, error? }] — από εδώ μετρά το όριο 5/ώρα (SQL 17).
  emailSentAt  DateTime?
  emailSentTo  String?
  emailSendLog Json      @default("[]")

  gdprConsent   Boolean   @default(false)
  gdprConsentAt DateTime?

  isSigned    Boolean   @default(false)
  signedAt    DateTime?
  signedIp    String?
  completedAt DateTime?

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking           @relation(fields: [bookingId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  template ContractTemplate? @relation(fields: [templateId], references: [id])

  @@unique([tenantId, contractNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "contracts_searchText_trgm_idx")
  @@map("contracts")
}

// ─────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────

model Invoice {
  id            String  @id @default(cuid())
  tenantId      String
  bookingId     String  @unique
  customerId    String
  invoiceNumber String // INV-001 — παλιός αύξων αριθμός, ΔΕΝ εμφανίζεται πια
  // Ο κωδικός που βλέπουν πελάτης και χρήστες (π.χ. K7M2-X9PQ), τυχαίος,
  // μοναδικός σε ΟΛΗ τη βάση. Παράγεται ΜΟΝΟ από src/lib/invoiceCode.ts.
  // Nullable μόνο για τη μετάβαση (backfill στο prisma/sql/19-invoice-pdf.sql).
  invoiceCode   String? @unique

  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidAt    DateTime?

  subtotal  Decimal @db.Decimal(10, 2)
  taxRate   Decimal @default(24) @db.Decimal(5, 2)
  taxAmount Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  status        InvoiceStatus @default(UNPAID)
  paymentMethod String? // cash, card, bank, stripe
  notes         String?
  pdfUrl        String?

  // Πότε στάλθηκε στον πελάτη (τελευταία επιτυχής αποστολή email).
  sentAt DateTime?

  // Αποστολή με email (Resend + PDF), όπως στα συμβόλαια (SQL 19):
  // τελευταία επιτυχία, σε ποιο email, και ιστορικό ΟΛΩΝ των προσπαθειών
  // [{ id, at, ok, lang, to (μασκαρισμένο), by, error? }] — από εδώ μετρά
  // το όριο 5 αποστολές/ώρα ανά τιμολόγιο.
  emailSentAt  DateTime?
  emailSentTo  String?
  emailSendLog Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  // Ο αριθμός τιμολογίου είναι μοναδικός ΜΕΣΑ στην εταιρία: το constraint
  // είναι αυτό που κάνει ασφαλή την ταυτόχρονη έκδοση.
  @@unique([tenantId, invoiceNumber])
  // Έσοδα διαστήματος στα Οικονομικά και στον Πίνακα.
  @@index([tenantId, status, paidAt])
  // Σελιδοποίηση: νεότερα πρώτα ανά εταιρία (SQL 32).
  @@index([tenantId, issueDate(sort: Desc), id(sort: Desc)])
  @@map("invoices")
}

// ─────────────────────────────────────────
// SERVICE & MAINTENANCE
// ─────────────────────────────────────────

model ServiceRecord {
  id              String      @id @default(cuid())
  tenantId        String
  vehicleId       String
  type            ServiceType
  date            DateTime
  km              Int?
  cost            Decimal?    @db.Decimal(10, 2)
  shop            String?
  description     String?
  nextServiceKm   Int?
  nextServiceDate DateTime?
  documents       String[] // Cloudinary URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId, vehicleId])
  @@index([tenantId, nextServiceDate])
  @@map("service_records")
}

// ─────────────────────────────────────────
// DAMAGES
// ─────────────────────────────────────────

model Damage {
  id          String       @id @default(cuid())
  tenantId    String
  vehicleId   String
  bookingId   String?
  description String
  // Πότε έγινε η ζημιά. Ξεχωριστό από το createdAt: μια ζημιά μπορεί να
  // καταχωρηθεί μέρες αφότου συνέβη.
  date        DateTime     @default(now())
  repairCost  Decimal?     @db.Decimal(10, 2)
  status      DamageStatus @default(PENDING)
  // Διαδρομές αρχείων στο ιδιωτικό bucket (tenantId/damages/damageId/…).
  // Τιμές που ξεκινούν με http (παλιά) εμφανίζονται ως έχουν.
  photos      String[]
  resolvedAt  DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId])
  @@index([tenantId, status])
  @@map("damages")
}

// ─────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────

model Expense {
  id        String   @id @default(cuid())
  tenantId  String
  vehicleId String?
  type      String // insurance, service, fuel, salary, rent, marketing, other
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime
  notes     String?
  receipt   String? // Cloudinary URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  // Φίλτρα της σελίδας Οικονομικά: διάστημα, και διάστημα ανά όχημα.
  @@index([tenantId, date])
  @@index([tenantId, vehicleId])
  @@map("expenses")
}

// ─────────────────────────────────────────
// DISCOUNTS & PROMOTIONS
// ─────────────────────────────────────────

// Πρόσθετα και ασφάλειες που ορίζει η κάθε εταιρία· θα μπαίνουν στις
// κρατήσεις στο Βήμα 2.
model Extra {
  id              String     @id @default(cuid())
  tenantId        String
  name            String
  price           Decimal    @db.Decimal(10, 2)
  chargeType      ChargeType @default(PER_DAY)
  type            ExtraType  @default(EXTRA)
  // Απαλλαγή (excess) σε € — μόνο για ασφάλειες. Snapshot στο συμβόλαιο.
  excess          Decimal?   @db.Decimal(10, 2)
  isActive        Boolean    @default(true)
  // Δημόσιο site (SQL 21). Τα ποσά μένουν σε € (Decimal)· cents μόνο στον
  // κώδικα (src/lib/public/money.ts). "name" μένει το κύριο (ελληνικό) όνομα.
  nameI18n        Json       @default("{}")
  descriptionI18n Json       @default("{}")
  /// Μόνο ασφάλειες (SQL 25): λίστα καλύψεων [{el,en}, …] — μία γραμμή ανά κάλυψη.
  coveragesI18n   Json       @default("[]")
  /// Ταβάνι συνολικής χρέωσης σε € (null = χωρίς ταβάνι).
  maxTotal        Decimal?   @db.Decimal(10, 2)
  maxQuantity     Int        @default(1)
  /// 'car' | 'moto' | 'atv' — κενό = για όλα.
  vehicleTypes    String[]   @default([])
  sortOrder       Int        @default(0)
  /// ΚΑΤΑΡΓΗΘΗΚΕ για τις ασφάλειες (SQL 25): καμία ασφάλεια δεν μπαίνει
  /// αυτόματα στην τιμή. Η στήλη μένει (δεδομένα ανέπαφα), ο κώδικας την αγνοεί.
  isDefault       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("extras")
}

model Discount {
  id          String         @id @default(cuid())
  tenantId    String
  code        String? // null = automatic discount
  name        String
  description String?
  type        DiscountType   @default(PERCENTAGE)
  value       Decimal        @db.Decimal(10, 2) // % ή €
  target      DiscountTarget @default(ALL)
  targetValue String? // category name ή vehicle ID ή customer ID

  minDays     Int? // minimum rental days
  minAmount   Decimal? @db.Decimal(10, 2)
  maxDiscount Decimal? @db.Decimal(10, 2) // cap σε €

  validFrom  DateTime?
  validUntil DateTime?
  usageLimit Int?
  usageCount Int       @default(0)
  isActive   Boolean   @default(true)

  // Loyalty: αυτόματη έκπτωση βάσει ιστορικού
  isLoyalty          Boolean @default(false)
  loyaltyMinBookings Int?

  // Seasonal
  isSeasonal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("discounts")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id       String           @id @default(cuid())
  tenantId String
  type     NotificationType
  title    String
  message  String
  link     String? // relative URL
  isRead   Boolean          @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────
// ACTIVITY LOG (Audit Trail)
// ─────────────────────────────────────────

model ActivityLog {
  id        String  @id @default(cuid())
  tenantId  String?
  userId    String
  action    String // "booking.created", "vehicle.updated", "contract.signed"
  entity    String? // "Booking", "Vehicle", etc.
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

// ─────────────────────────────────────────
// PLATFORM DISCOUNT CODES (Super Admin)
// ─────────────────────────────────────────

model PlatformCoupon {
  id          String            @id @default(cuid())
  code        String            @unique
  description String?
  planTarget  SubscriptionPlan? // null = all plans
  type        DiscountType
  value       Decimal           @db.Decimal(10, 2)
  validFrom   DateTime?
  validUntil  DateTime?
  usageLimit  Int?
  usageCount  Int               @default(0)
  isActive    Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_coupons")
}

// ─────────────────────────────────────────
// ΔΗΜΟΣΙΟ SITE — ρυθμίσεις κρατήσεων και τιμές (SQL 21)
// ─────────────────────────────────────────
// Όλα τα ποσά σε CENTS (ακέραια λεπτά, με ΦΠΑ). Κείμενα JSONB ανά γλώσσα.
// Μηχανή τιμής: src/lib/public/pricing.ts.

model RentalGroup {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  vehicleType     String   @default("car")
  name            Json     @default("{}")
  description     Json     @default("{}")
  similarModels   Json     @default("{}")
  seats           Int      @default(5)
  doors           Int?
  transmission    String   @default("manual")
  fuel            FuelType @default(PETROL)
  bagsLarge       Int      @default(0)
  bagsSmall       Int      @default(0)
  airCondition    Boolean  @default(true)
  engineCc        Int?
  minDriverAge    Int?
  licenceCategory String?
  /// Ίδια μορφή με vehicles.photos — έως 10.
  photos          Json     @default("[]")
  basePriceCents  Int      @default(0)
  depositCents    Int?
  excessCents     Int?
  sortOrder       Int      @default(0)
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  rates    Rate[]
  bookings Booking[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("rental_groups")
}

model PickupLocation {
  id                 String   @id @default(cuid())
  tenantId           String
  slug               String
  name               Json     @default("{}")
  type               String   @default("other")
  address            String?
  lat                Float?
  lng                Float?
  askFlightNumber    Boolean  @default(false)
  askFerryName       Boolean  @default(false)
  askAddress         Boolean  @default(false)
  /// 'none' | 'percent' | 'fixed'· αρνητικό value = έκπτωση (percent: %, fixed: cents).
  adjustmentType     String   @default("none")
  adjustmentValue    Int      @default(0)
  adjustmentLabel    Json     @default("{}")
  /// null = προεπιλογή εταιρίας, 0 = δωρεάν.
  afterHoursFeeCents Int?
  allowPickup        Boolean  @default(true)
  allowDropoff       Boolean  @default(true)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  /// Χρεώσεις δρομολογίου (SQL 21c), cents: παράδοση = ο πελάτης ΠΑΡΑΛΑΜΒΑΝΕΙ εδώ,
  /// παραλαβή = ο πελάτης ΕΠΙΣΤΡΕΦΕΙ εδώ. Από feeFreeFromDays ημέρες και πάνω = 0.
  deliveryFeeCents   Int      @default(0)
  collectionFeeCents Int      @default(0)
  feeFreeFromDays    Int?
  feeLabel           Json     @default("{}")
  /// Google Place ID (SQL 26) — για τις κριτικές Google (Places API, χωρίς αποθήκευση).
  googlePlaceId      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  places  PlaceLocation[]
  reviews Review[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("pickup_locations")
}

model Season {
  id            String   @id @default(cuid())
  tenantId      String
  name          Json     @default("{}")
  /// 'MM-DD'· το end μπορεί να είναι πριν το start (π.χ. 12-15 → 01-10).
  startMonthDay String
  endMonthDay   String
  minDays       Int?
  /// Σε επικάλυψη κερδίζει η μεγαλύτερη.
  priority      Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates  Rate[]

  @@index([tenantId])
  @@map("seasons")
}

model Rate {
  id            String   @id @default(cuid())
  tenantId      String
  /// null = όλο τον χρόνο.
  seasonId      String?
  /// ΑΚΡΙΒΩΣ ένα από rentalGroupId / vehicleId (CHECK στη βάση).
  rentalGroupId String?
  vehicleId     String?
  /// [{ minDays, maxDays (null = ∞), dailyPriceCents }]
  tiers         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  season      Season?      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rentalGroup RentalGroup? @relation(fields: [rentalGroupId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Στη βάση: NULLS NOT DISTINCT (SQL 21).
  @@unique([tenantId, seasonId, rentalGroupId, vehicleId])
  @@index([tenantId])
  @@map("rates")
}

model DriverAgeBand {
  id                String   @id @default(cuid())
  tenantId          String
  minAge            Int
  maxAge            Int
  label             Json     @default("{}")
  explanation       Json     @default("{}")
  allowed           Boolean  @default(true)
  isDefault         Boolean  @default(false)
  /// 'none' | 'per_day' | 'per_rental'
  surchargeType     String   @default("none")
  surchargeCents    Int      @default(0)
  surchargeMaxCents Int?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("driver_age_bands")
}

/// Προσφορές / εκπτώσεις (SQL 21c). Κενή λίστα = ισχύει για όλα.
/// Χωρίς άθροισμα: η quote() εφαρμόζει μόνο τη μεγαλύτερη (μαζί με την έκπτωση τοποθεσίας).
model Promotion {
  id             String   @id @default(cuid())
  tenantId       String
  name           Json     @default("{}")
  badge          Json     @default("{}")
  isActive       Boolean  @default(true)
  /// 'percent' | 'per_day' | 'per_rental'
  discountType   String   @default("percent")
  /// percent: 1–90 · per_day / per_rental: cents
  discountValue  Int
  validFrom      DateTime @db.Date
  validTo        DateTime @db.Date
  locationIds    String[] @default([])
  /// 'pickup' | 'dropoff' | 'either'
  locationMatch  String   @default("pickup")
  rentalGroupIds String[] @default([])
  vehicleIds     String[] @default([])
  vehicleTypes   String[] @default([])
  minDays        Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("promotions")
}

// ─────────────────────────────────────────
// ΠΑΚΕΤΑ (entitlements) — SQL 20
// ─────────────────────────────────────────
// Οι τιμές αλλάζουν ΜΟΝΟ στη βάση, χωρίς deploy. Λογική: src/lib/entitlements.ts.
// modules: {"dashboard":true,"publicSite":false} — ό,τι λείπει = false.
// limits:  {"maxUsers":1,"maxVehicles":null}     — null/απόν = απεριόριστο.

model Plan {
  key       String   @id
  name      String
  modules   Json     @default("{}")
  limits    Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenants Tenant[]

  @@map("plans")
}

// ─────────────────────────────────────────
// PLATFORM DISCOUNTS — έκπτωση στη συνδρομή μιας εταιρίας (Super Admin)
// ─────────────────────────────────────────
// Μόνο αποθήκευση/εμφάνιση· δεν συνδέεται ακόμα με Stripe/billing.
// Κανόνας: το πολύ ΜΙΑ ενεργή έκπτωση ανά εταιρία σε κάθε διάστημα
// (ελέγχεται στο API). validUntil = null → ισχύει μέχρι να διακοπεί.

model PlatformDiscount {
  id         String               @id @default(cuid())
  tenantId   String
  type       PlatformDiscountType
  // Ποσοστό (0–100] ή σταθερό ποσό € ανά μήνα.
  value      Decimal              @db.Decimal(10, 2)
  validFrom  DateTime             @db.Date
  validUntil DateTime?            @db.Date
  active     Boolean              @default(true)
  note       String?
  createdAt  DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("platform_discounts")
}

/// Όρια κατάχρησης για τα δημόσια endpoints (SQL 23) — μετρητής ανά κλειδί
/// και παράθυρο χρόνου. Το κλειδί είναι HASH (ποτέ IP ή email σε καθαρή μορφή).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

/// Μηνύματα προς τον πελάτη για επιβεβαίωση/ακύρωση κράτησης (SQL 24).
/// Χωρίς προσωπικά στοιχεία: μόνο τύπος, κανάλι, αποτέλεσμα και κωδικός σφάλματος.
model BookingNotification {
  id        String   @id @default(cuid())
  tenantId  String
  bookingId String
  /// 'confirm' | 'cancel'
  kind      String
  /// 'email' | 'whatsapp' | 'mailto'
  channel   String
  /// 'sent' | 'failed' | 'opened' (χειροκίνητη αποστολή: άνοιξε το WhatsApp/email)
  result    String
  error     String?
  lang      String?
  userId    String?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookingId])
  @@map("booking_notifications")
}

/// «Μέρη για επίσκεψη» του δημόσιου site (SQL 26). Κείμενα ανά γλώσσα (JSONB),
/// φωτογραφίες Cloudinary (fleetpro/{companyId}/places/{placeId}), η πρώτη = εξώφυλλο.
model Place {
  id              String   @id @default(cuid())
  tenantId        String
  /// Μικρά λατινικά, αριθμοί, παύλες — μοναδικό ανά εταιρία (URL /places/<slug>).
  slug            String
  nameI18n        Json     @default("{}")
  /// Μία γραμμή (κάτω από τον τίτλο).
  shortI18n       Json     @default("{}")
  descriptionI18n Json     @default("{}")
  /// [{ label: {el,en}, value: {el,en} }] — ώρες, είσοδος, απόσταση, συμβουλές.
  detailsI18n     Json     @default("[]")
  mapUrl          String?
  /// Η πρώτη φωτογραφία (συγχρονίζεται σε κάθε αλλαγή φωτογραφιών).
  coverImage      String?
  photos          Json     @default("[]")
  /// true = για όλες τις τοποθεσίες· false = μόνο όσες είναι στο place_locations.
  allLocations    Boolean  @default(true)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations PlaceLocation[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("places")
}

model PlaceLocation {
  placeId          String
  pickupLocationId String

  place          Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)

  @@id([placeId, pickupLocationId])
  @@index([pickupLocationId])
  @@map("place_locations")
}

/// Κριτικές πελατών που προσθέτει ΧΕΙΡΟΚΙΝΗΤΑ η εταιρία (SQL 26). Οι κριτικές
/// Google ΔΕΝ αποθηκεύονται — έρχονται από το Places API με cache 24 ωρών.
model Review {
  id               String   @id @default(cuid())
  tenantId         String
  /// null = γενική κριτική της εταιρίας.
  pickupLocationId String?
  authorName       String
  /// 1–5 (CHECK στη βάση).
  rating           Int
  /// Το κείμενο ανά γλώσσα {el,en} (συνήθως μία, στη γλώσσα του πελάτη).
  text             Json     @default("{}")
  reviewDate       DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  sourceUrl        String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pickupLocation PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("reviews")
}

// Online πληρωμή μιας κράτησης — μία γραμμή ανά Stripe Checkout Session (SQL 27).
// Ποσά σε cents. ΚΑΝΕΝΑ στοιχείο κάρτας.
model BookingPayment {
  id                      String    @id @default(cuid())
  tenantId                String
  bookingId               String
  stripeAccountId         String
  stripeCheckoutSessionId String    @unique
  stripePaymentIntentId   String?
  checkoutUrl             String?
  amountCents             Int
  refundedCents           Int       @default(0)
  applicationFeeCents     Int       @default(0)
  currency                String    @default("eur")
  /// OPEN | PAID | FAILED | EXPIRED | REFUNDED | PARTIALLY_REFUNDED
  status                  String    @default("OPEN")
  /// [{ id, amountCents, at, userId }]
  refunds                 Json      @default("[]")
  /// Κράτηση υπολοίπου ως χρέωση ακύρωσης (SQL 28): refundedCents + retainedCents <= amountCents.
  retainedCents           Int       @default(0)
  retainedAt              DateTime?
  retainedNote            String?
  /// userId του Διαχειριστή που το αποφάσισε.
  retainedBy              String?
  /// BOOKING = online πληρωμή κράτησης (site) | CONTRACT = ενοίκιο από το συμβόλαιο (SQL 29).
  purpose                 String    @default("BOOKING")
  expiresAt               DateTime?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookingId])
  @@index([tenantId, bookingId, purpose])
  @@index([stripePaymentIntentId])
  @@map("booking_payments")
}

// Events του Stripe Connect webhook που εφαρμόστηκαν (idempotency).
model StripeEvent {
  id         String   @id
  type       String
  account    String?
  receivedAt DateTime @default(now())

  @@map("stripe_events")
}

// Νομικά κείμενα του δημόσιου site (SQL 31) — ΜΟΝΟ όσα αποθήκευσε η εταιρία.
// Κάθε αποθήκευση = νέα γραμμή (version + 1)· ισχύει η μεγαλύτερη έκδοση.
// Χωρίς γραμμή = το πρότυπο (src/lib/legal/templates.ts).
model SiteLegalText {
  id          String   @id @default(cuid())
  tenantId    String
  /// 'terms' | 'privacy' | 'cookies' (CHECK στη βάση).
  kind        String
  lang        String
  version     Int
  /// Markdown (περιορισμένο) — αποδίδεται ΧΩΡΙΣ raw HTML (src/lib/legal/markdown.ts).
  body        String   @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, lang, version])
  @@map("site_legal_texts")
}
